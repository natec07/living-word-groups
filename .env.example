# Copy this file to .env and fill in real values before deploying.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string. In local dev you can run `npm run db:dev`
# to start a bundled, no-Docker Postgres instance on port 5433.
DATABASE_URL="postgresql://user:password@localhost:5432/livingword?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in button is hidden if unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Transactional email (Resend) ───────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Groups - Living Word Rockland <hello@livingwordrockland.church>"

# ── File uploads (UploadThing) ─────────────────────────────────────────
UPLOADTHING_TOKEN=""

# ── Sermon sync (YouTube Data API v3) ───────────────────────────────────
# Create a key at https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" for a project — no OAuth needed, this is
# a plain API key. Pulls new uploads from the @livingwordma channel into
# the Watch library (see src/lib/youtube.ts). Without a key, the manual
# "Sync from YouTube" button and the /api/cron/sync-youtube route both
# fail with a clear error instead of the app crashing.
YOUTUBE_API_KEY=""

# Shared secret the cron route checks so only your scheduler (Vercel Cron,
# etc.) can trigger a sync — pick any random string. Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET` if this is set in
# your Vercel project's env vars; without it, the route stays open (fine
# for local testing, not for a public deployment).
CRON_SECRET=""

# ── Realtime (Pusher) — used for messaging & live notifications ────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── iOS push notifications (APNs) — only relevant if the dormant ios/
# Capacitor project is ever built and shipped natively. The PWA (the
# actual distribution path) uses Web Push below instead.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="net.livingword.community"
APNS_ENVIRONMENT="development"

# ── Web Push (VAPID) — powers notifications for the installable PWA ────
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@livingword.church"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ── Translation (DeepL) ────────────────────────────────────────────────
DEEPL_API_KEY=""

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Groups - Living Word Rockland"
